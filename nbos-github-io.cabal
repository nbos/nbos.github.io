cabal-version:      >= 1.10
name:               nbos-github-io
version:            0.1.0.1
build-type:         Simple

executable site
  main-is:          site.hs
  build-depends: base >= 4.20.2 && < 4.21
               , hakyll >= 4.17.0 && < 4.18
               , time >= 1.12.2 && < 1.13
               , tagsoup >= 0.14.8 && < 0.15
               , pandoc >= 3.11 && < 3.12
               , pandoc-types >= 1.23.1 && < 1.24
               , directory >= 1.3.8 && < 1.4
               , filepath >= 1.5.4 && < 1.6
               , text >= 2.1.3 && < 2.2

  ghc-options:      -threaded -rtsopts -with-rtsopts=-N -Wall
  default-language: Haskell2010
